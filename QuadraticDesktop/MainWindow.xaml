<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuadraticDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuadraticDesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QuadraticDesktop">

    <Grid Background="#f5f8fb" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- R0 Coefficient input -->
        <Border Margin="20,20,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <!-- R0 Header -->
                <TextBlock Text="Решение квадратного уравнения" FontSize="22"
                           Grid.ColumnSpan="2" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <!-- R1 Equation form label -->
                <TextBlock Text="ax² + bx + c = 0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="22" FontFamily="Cambria" FontStyle="Italic"
                           Foreground="Red"/>
                
                <!-- R2 a-coeff input -->
                <TextBlock Text="a =" Grid.Row="2" Style="{StaticResource CoeffInputTextBlockStyle}"/>
                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="nbxCoeffA" AutomationProperties.Name="Коэффициент a"
                           Style="{StaticResource CoeffInputNumberBoxStyle}"/>

                <!-- R3 b-coeff input -->
                <TextBlock Text="b =" Grid.Row="3" Style="{StaticResource CoeffInputTextBlockStyle}"/>
                <NumberBox Grid.Row="3" Grid.Column="1" x:Name="nbxCoeffB" Style="{StaticResource CoeffInputNumberBoxStyle}"/>
                
                <!-- R4 c-coeff input -->
                <TextBlock Text="c =" Grid.Row="4" Style="{StaticResource CoeffInputTextBlockStyle}"/>
                <NumberBox Grid.Row="4" Grid.Column="1" x:Name="nbxCoeffC" Style="{StaticResource CoeffInputNumberBoxStyle}"/>
                <!-- R5 Solve button -->
                <Button Grid.Row="5" Grid.ColumnSpan="2" Background="Red" HorizontalAlignment="Center" Height="40" Width="220" 
                        x:Name="SolveButton" Click="SolveButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/calculator.png" MaxHeight="20" MaxWidth="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Решить" FontWeight="SemiBold" Foreground="White" FontSize="17"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Border>

        <!-- R1 Solution output -->
        <Border Margin="20,10,10,20" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- R0 Header -->
                <TextBlock Text="Результат" Foreground="Red" FontWeight="SemiBold" FontSize="18" 
                           Margin="20,10,0,0" Grid.ColumnSpan="2"/>
                
                <!-- R1 Input wating label -->
                <TextBlock Grid.Row="1" Text="Введите коэффициенты, чтобы получить корни и дискриминант" 
                           Foreground="#9c9c9c" Width="200" TextWrapping="Wrap" FontSize="15"
                           x:Name="tbWaitCoeff"/>
                
                <!-- R1 Solution output (hidden by default) -->
                <Grid Grid.Row="1" Visibility="Collapsed" x:Name="grdOutput">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- R0 Discriminant -->
                    <Border Style="{StaticResource ResultBadgeStyle}">
                        <TextBlock Text="D" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontFamily="Cambria" FontSize="18" Foreground="Red"/>
                    </Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource ResultOutputTextBlockStyle}">
                        <Run Text="D = "/>
                        <Run x:Name="dField"/>
                    </TextBlock>
                    
                    <!-- R1 X1 -->
                    <Border Grid.Row="1" Style="{StaticResource ResultBadgeStyle}">
                        <TextBlock Text="x₁" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Cambria" FontSize="18" Foreground="Red"/>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbFirstRoot" Style="{StaticResource ResultOutputTextBlockStyle}"> 
                        <Run Text="x₁ = "/>
                        <Run x:Name="x1Field"/>
                    </TextBlock>
                    <Line Grid.Row="1" X1="0" X2="230" Y1="0" Y2="0" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>

                    <!-- R2 X2 -->
                    <Border Grid.Row="2" Style="{StaticResource ResultBadgeStyle}">
                        <TextBlock Text="x₂" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Cambria" FontSize="18" Foreground="Red"/>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbSecondRoot" Style="{StaticResource ResultOutputTextBlockStyle}">
                        <Run Text="x₂ = "/>
                        <Run x:Name="x2Field"/>
                    </TextBlock>
                    <Line Grid.Row="2" X1="0" X2="230" Y1="0" Y2="0" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
                    
                    <!-- R3 Explanation -->
                    <Border x:Name="brdTwoRootsMsg" Grid.Row="3" Grid.ColumnSpan="2" Background="#eff9ef" 
                            Style="{StaticResource ResultExplanationBorderStyle}" BorderBrush="LightGreen">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image Source="/Assets/check.png" MaxHeight="15" MaxWidth="15" Margin="15,0"/>
                            <TextBlock Text="Два различных корня" 
                                        Foreground="Green"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="brdOneRootMsg" Grid.Row="3" Grid.ColumnSpan="2" Background="#eff9ef"
                            Style="{StaticResource ResultExplanationBorderStyle}" BorderBrush="LightGreen">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image Source="/Assets/check.png" MaxHeight="15" MaxWidth="15" Margin="15,0"/>
                            <TextBlock Text="Один корень" 
                                       Foreground="Green"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="brdNoRootsMsg" Grid.Row="3" Grid.ColumnSpan="2" Background="#fce3e3" 
                            Style="{StaticResource ResultExplanationBorderStyle}" BorderBrush="#ff6969">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image Source="/Assets/redcross.png" MaxHeight="15" MaxWidth="15" Margin="15,0"/>
                            <TextBlock Text="Нет корней" Foreground="Red"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="brdInfRootsMsg" Grid.Row="3" Grid.ColumnSpan="2" Background="#c9c9ff" 
                            Style="{StaticResource ResultExplanationBorderStyle}" BorderBrush="#b3b3ff" >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="i" Margin="15,0" Foreground="#4444fc"  FontFamily="Cambria" FontSize="25" 
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="Корень - любое число" Foreground="#4444fc" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                    </Border>
                </Grid>
            </Grid>
        </Border>
        
        <!-- R0-1 Plot -->
        <Border Margin="10,20,20,20" Grid.RowSpan="2" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <!-- R0-2 Plot view -->
                <WebView2 x:Name="GraphView" Grid.RowSpan="3" Margin="0,5,0,30"
                          Loaded="GraphView_Loaded"
                          NavigationCompleted="GraphView_NavigationCompleted"/>

                <!-- R0 Header -->
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Margin="0,10">
                    <Image MaxHeight="20" MaxWidth="20" Source="/Assets/plot.png" Margin="15 0"/>
                    <TextBlock Text="График функции" FontWeight="SemiBold" FontSize="18"/>
                </StackPanel>
                
                <!-- R1 Equation string -->
                <Border Height="40" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="0,50,10,0" Name="brdEquationString">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Line Stroke="Red" X1="0" X2="30" Y1="20" Y2="20" StrokeThickness="3" Margin="10,0"/>
                        <TextBlock x:Name="tbEquationString" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0"/>
                    </StackPanel>
                </Border>


                <!-- R2 -->
                <Border Grid.Row="2" Margin="30,0,30,10" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <!-- C1 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Height="20" Width="20" Fill="MediumPurple"/>
                            <StackPanel VerticalAlignment="Center" Margin="20, 0" MinWidth="100">
                                <TextBlock Text="Вершина" FontWeight="SemiBold"/>
                                <TextBlock x:Name="tbVertexCords" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Line Y1="0" Y2="50"/>
                        </StackPanel>
                        <!-- C2 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Height="20" Width="20" Fill="Blue"/>
                            <StackPanel VerticalAlignment="Center" Margin="20, 0" MinWidth="110">
                                <TextBlock Text="Ось симметрии" FontWeight="SemiBold"/>
                                <TextBlock x:Name="tbAxisOfSymmetry" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Line Y1="0" Y2="50"/>
                        </StackPanel>
                        <!-- C3 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Assets/uparrow.png" MaxHeight="40" MaxWidth="40"/>
                            <StackPanel VerticalAlignment="Center" Margin="20, 0" MinWidth="150">
                                <TextBlock Text="Направление ветвей" FontWeight="SemiBold"/>
                                <TextBlock x:Name="tbBranchesDirection" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
