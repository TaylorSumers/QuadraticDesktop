<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuadraticDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuadraticDesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QuadraticDesktop">

    <Grid Background="LightGray" >
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="1" Grid.Column="0"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="1" Grid.Column="1"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="2" Grid.Column="0"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="2" Grid.Column="1"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="3" Grid.Column="0"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="3" Grid.Column="1"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="4" Grid.Column="0"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="4" Grid.Column="1"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="5" Grid.Column="0"  BorderBrush="Black" BorderThickness="1"/>
        <Border Grid.Row="5" Grid.Column="1"  BorderBrush="Black" BorderThickness="1"/>
        
        <TextBlock Text="Ввод коэффициентов:" Foreground="Black" FontSize="27"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2"/>

        <TextBlock Grid.Row="1" Text="a =" Foreground="Black" HorizontalAlignment="Right" 
                   VerticalAlignment="Center" FontSize="25" Margin="15"/>
        <TextBlock Grid.Row="2" Text="b =" Foreground="Black" HorizontalAlignment="Right" 
                   VerticalAlignment="Center" FontSize="25" Margin="15"/>
        <TextBlock Grid.Row="3" Text="c =" Foreground="Black" HorizontalAlignment="Right" 
                   VerticalAlignment="Center" FontSize="25" Margin="15"/>

        <TextBox Grid.Row="1" Grid.Column="1" Height="30" Width="180" Background="White" 
                 BorderBrush="Black" Foreground="Black" HorizontalAlignment="Left"/>

        <TextBox Grid.Row="2" Grid.Column="1" Height="30" Width="180" Background="White" 
                 BorderBrush="Black" Foreground="Black" HorizontalAlignment="Left"/>

        <TextBox Grid.Row="3" Grid.Column="1" Height="30" Width="180" Background="White" 
                 BorderBrush="Black" Foreground="Black" HorizontalAlignment="Left"/>


        <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Решить" Background="Gray" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="200" Height="50" Margin="20"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                   Foreground="Black" Margin="0 10 0 0" FontSize="20">
            <Run Text="x1 = "/>
            <Run Text="Ans"/>
            <Run Text="x2 = "/>
            <Run Text="Ans"/>
        </TextBlock>
        
        <TextBlock Grid.Row="5" Grid.Column="0" TextWrapping="Wrap" MaxWidth="180" Grid.ColumnSpan="2" 
                   Foreground="Black" HorizontalAlignment="Left" Margin="10">
            <Run Text="Quadratic Desktop" FontSize="20"/>
            <Run Text="(C) SUT, 2026"/>
        </TextBlock>
    </Grid>
</Window>
